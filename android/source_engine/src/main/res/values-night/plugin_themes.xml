<resources>
    <color name="plugin_surface">#17212E</color>
    <color name="plugin_text">#ECF2FA</color>
    <color name="plugin_muted">#ADBACC</color>
    <color name="plugin_primary">#99C9FF</color>
    <color name="plugin_soft">#25364A</color>
    <style name="LiuguangPluginHostTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:alertDialogTheme">@style/LiuguangPluginAlertTheme</item>
        <item name="android:colorAccent">@color/plugin_primary</item>
        <item name="android:fontFamily">sans</item>
    </style>
    <style name="LiuguangPluginAlertTheme" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/plugin_dialog_background</item>
        <item name="android:windowMinWidthMajor">86%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="android:backgroundDimAmount">0.42</item>
        <item name="android:colorBackground">@color/plugin_surface</item>
        <item name="android:colorAccent">@color/plugin_primary</item>
        <item name="android:textColorPrimary">@color/plugin_text</item>
        <item name="android:textColorSecondary">@color/plugin_muted</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:buttonBarButtonStyle">@style/LiuguangPluginDialogButton</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/LiuguangPluginDialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/LiuguangPluginDialogButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/LiuguangPluginDialogButton</item>
    </style>
</resources>
